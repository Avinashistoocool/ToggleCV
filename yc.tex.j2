\newcommand{\fitline}[2]{%
  \setbox0\hbox{#2}%
  \setbox2\vbox{\hsize\linewidth\parfillskip=0pt\noindent #2\par\xdef\fitlines{\the\prevgraf}}%
  \immediate\write\fitfile{#1:\the\wd0:\the\linewidth:\fitlines}%
  {\parfillskip=0pt #2\par}%
}
